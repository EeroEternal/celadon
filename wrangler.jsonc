{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "xgateway-keeper",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  // Midnight UTC: deep nightly scan. Every 6 hours: quick health scan.
  "triggers": { "crons": ["0 0 * * *", "0 */6 * * *"] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FlueKeeperAgent"] }],
  "vars": {
    "TARGET_REPO": "EeroEternal/xgateway"
  }
}
